  <!--
    Inspired by Core's TileStoneBase. Work, research, construction skill,
    deconstruction and dropdown behaviour are inherited from normal stone tile.
    The live smoothed-floor texture/color and equivalent tile wealth are copied
    at startup by ChunkConstructionController.
  -->
  <TerrainDef Name="SmoothingExpanded_ChunkSmoothFloorBase" ParentName="TileStoneBase" Abstract="True">
    <description>A constructed floor made directly from a raw stone chunk and polished to a smooth finish.</description>
    <texturePath>Terrain/Surfaces/SmoothStone</texturePath>
    <designatorDropdown>SmoothingExpanded_ChunkSmoothFloors</designatorDropdown>
    <!-- Raw chunks need no cutting or shaping prerequisite before floor work. -->
    <constructionSkillPrerequisite>0</constructionSkillPrerequisite>
    <researchPrerequisites Inherit="False" />
    <!-- Use RimWorld's normal deconstruction return instead of forcing a full
         refund. Dedicated refund mods can therefore control these floors. -->
  </TerrainDef>

