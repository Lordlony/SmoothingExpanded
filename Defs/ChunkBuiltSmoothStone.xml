  <!--
    Natural-result construction uses short-lived building helpers rather than
    custom terrains. This lets RimWorld charge one chunk and perform normal
    construction work, after which NaturalSurfaceCompletionComponent replaces
    the helper with the genuine vanilla smoothed asset. The result therefore
    has vanilla blending, durability, mod compatibility and uninstall safety.
  -->
  <ThingDef Name="SmoothingExpanded_ChunkSmoothNaturalWallBase" ParentName="Wall" Abstract="True">
    <thingClass>Lordlony.SmoothingExpanded.NaturalSurfaceConstructionProxy</thingClass>
    <tickerType>Normal</tickerType>
    <description>Consumes one raw chunk to construct a genuine vanilla smoothed stone wall. Once complete, it cannot be deconstructed for the chunk.</description>
    <!-- This short-lived construction proxy must only ever be created through
         its player blueprint, never selected as generated map content. -->
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <uiIconPath>Things/Building/Linked/WallSmooth_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Linked/RockSmooth_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags Inherit="False"><li>Wall</li><li>Rock</li></linkFlags>
    </graphicData>
    <costStuffCount>0</costStuffCount>
    <stuffCategories Inherit="False" />
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <designatorDropdown>SmoothingExpanded_ChunkSmoothNaturalWalls</designatorDropdown>
    <researchPrerequisites Inherit="False" />
    <building>
      <!-- As with the constructed catalogue, this fixed-chunk helper is not
           made from Stuff. Avoid Odyssey attempting a Stuff-based airtight
           lookup while its blueprint, frame, or brief completed form exists. -->
      <isAirtight>false</isAirtight>
      <isStuffableAirtight>false</isStuffableAirtight>
    </building>
  </ThingDef>

  <ThingDef Name="SmoothingExpanded_ChunkSmoothNaturalFloorBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Lordlony.SmoothingExpanded.NaturalSurfaceConstructionProxy</thingClass>
    <tickerType>Normal</tickerType>
    <category>Building</category>
    <!-- A one-cell floor helper has no meaningful rotation. More importantly,
         leaving this enabled makes RimWorld reserve Q/E for building rotation
         instead of cycling the Floors draw-shape catalogue. -->
    <rotatable>false</rotatable>
    <!-- Blueprint and frame defs are generated before the settings controller
         can show or hide Architect entries. Declaring Floors here ensures normal
         construction receives a valid blueprint; the controller may safely set
         the live category to null later when this result mode is disabled. -->
    <designationCategory>Floors</designationCategory>
    <!-- Match vanilla floor tools: drag paints a filled two-dimensional area
         while every cell still receives its own one-chunk construction frame. -->
    <drawStyleCategory>Floors</drawStyleCategory>
    <!-- A normal drawer is required so RimWorld generates blueprint/frame defs.
         The completed helper exists for only one tick before becoming terrain. -->
    <drawerType>MapMeshOnly</drawerType>
    <graphicData>
      <texPath>Terrain/Surfaces/SmoothStone</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <description>Consumes one raw chunk to construct genuine vanilla smoothed stone terrain. Once complete, it cannot be deconstructed for the chunk.</description>
    <uiIconPath>Terrain/Surfaces/SmoothStone</uiIconPath>
    <!-- Do not ask the blueprint to draw the completed MapMeshOnly helper as
         its ghost: MapMeshOnly has no realtime thing graphic, which leaves
         only the selection outline. Use blueprintGraphicData below instead. -->
    <useBlueprintGraphicAsGhost>false</useBlueprintGraphicAsGhost>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <costStuffCount>0</costStuffCount>
    <stuffCategories Inherit="False" />
    <designatorDropdown>SmoothingExpanded_ChunkSmoothNaturalFloors</designatorDropdown>
    <researchPrerequisites Inherit="False" />
    <constructionSkillPrerequisite>0</constructionSkillPrerequisite>
    <building>
      <isEdifice>false</isEdifice>
      <!-- MapMeshOnly helpers need an explicit blueprint graphic. The generic
           useBlueprintGraphicAsGhost flag alone can leave their empty blueprint
           invisible until the frame receives its first delivered resource. -->
      <blueprintClass>Blueprint_Build</blueprintClass>
      <blueprintGraphicData>
        <texPath>Terrain/Surfaces/SmoothStone</texPath>
        <graphicClass>Graphic_Single</graphicClass>
        <!-- EdgeDetect renders only the thin placement outline for this
             MapMeshOnly helper. Transparent keeps that outline while also
             displaying the smooth-stone texture before resources arrive. -->
        <shaderType>Transparent</shaderType>
        <drawSize>(1,1)</drawSize>
      </blueprintGraphicData>
    </building>
  </ThingDef>

