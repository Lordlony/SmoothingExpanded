  <!--
    Inspired by Core's Wall and Smoothed* rock ThingDefs. These definitions use
    one matching raw chunk, retain normal wall construction behaviour, and are
    configured from the live Core/modded definitions by ChunkConstructionController.
  -->
  <ThingDef Name="SmoothingExpanded_ChunkSmoothWallBase" ParentName="Wall" Abstract="True">
    <description>A constructed stone wall made directly from a raw chunk and finished with a smooth surface.</description>
    <!-- These are player construction choices, not world-generation content.
         Wall normally permits generic map-gen scattering, so opt this entire
         inherited family out explicitly. -->
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <uiIconPath>Things/Building/Linked/WallSmooth_MenuIcon</uiIconPath>
    <graphicData>
      <texPath>Things/Building/Linked/RockSmooth_Atlas</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <linkType>CornerFiller</linkType>
      <linkFlags Inherit="False">
        <li>Wall</li>
        <li>Rock</li>
      </linkFlags>
    </graphicData>
    <costStuffCount>0</costStuffCount>
    <stuffCategories Inherit="False" />
    <useStuffTerrainAffordance>false</useStuffTerrainAffordance>
    <designatorDropdown>SmoothingExpanded_ChunkSmoothWalls</designatorDropdown>
    <!-- Use RimWorld's normal deconstruction return instead of forcing a full
         refund. Dedicated refund mods can therefore control these walls. -->
    <!-- Separate fixed-material defs otherwise appear as individual unlocks in
         Stonecutting's research panel. The opt-in mod setting is the catalogue
         gate; resources and construction work remain the balance costs. -->
    <researchPrerequisites Inherit="False" />
    <building>
      <deconstructible>true</deconstructible>
      <isWall>true</isWall>
      <supportsWallAttachments>true</supportsWallAttachments>
      <!-- Odyssey's wall information calculates airtightness from Stuff when
           isStuffableAirtight is inherited. These walls use a fixed chunk
           cost and therefore have no Stuff instance to inspect. Declare the
           finished chunk-built wall directly non-airtight instead. -->
      <isAirtight>false</isAirtight>
      <isStuffableAirtight>false</isStuffableAirtight>
    </building>
  </ThingDef>

